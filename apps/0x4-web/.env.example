# 0x4-web 环境变量模板（全部占位，无真实值）
# 复制为 .env 后填入自己的值：cp .env.example .env

# 后端 API（网页版留空走同源；原生 App 填绝对地址）
VITE_SOCIAL_API=
# Solana RPC（留空用公共节点兜底）
VITE_SOLANA_RPC=
# EVM 各链 RPC 覆盖：VITE_EVM_RPC_<chainId>，如 Monad testnet：
# VITE_EVM_RPC_10143=https://testnet-rpc.monad.xyz
VITE_EVM_RPC_10143=https://testnet-rpc.monad.xyz

# 行情 / 交易 API（留空用内置公共默认值）
VITE_JUPITER_API=
VITE_DEXSCREENER_API=
VITE_LIFI_API=
VITE_LIFI_API_KEY=
VITE_LIFI_INTEGRATOR=0x4

# WalletConnect（公开 project ID，非密钥）
VITE_WALLETCONNECT_ID=

# 平台费
VITE_PLATFORM_FEE_BPS=0
VITE_PLATFORM_FEE_ACCOUNT=

# BNG 代币
VITE_BNG_ADDRESS=
VITE_BNG_CHAIN=bsc

# 分享 / 推广
VITE_WEB_BASE=
VITE_SHARE_BASE=
VITE_EXTENSION_URL=
VITE_GAME_URL=

# 功能开关
VITE_BALANCE_FEATURES=
VITE_PUSH=
VITE_SURFACE=
VITE_DIAG=
VITE_DIAG_OPEN=
VITE_NO_PERP=
VITE_NO_ADOPT=
