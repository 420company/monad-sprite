# monad小精灵 —— 环境变量模板
# 复制为 .env 后填值。注意：.env 绝不提交到仓库（见 .gitignore）。
# 以下全是占位名/空值，逐行检查无真实值后再提交。

# --- 链 ---
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz
CHAIN_ID=10143

# --- Rug Radar 服务 ---
RADAR_API=http://localhost:3001

# --- 实盘（LIVE 专用，paper 模式不需要）---
# ⚠️ 填入即代表真钱风险。只在本地 .env，绝不进仓库。
MONAD_PRIVATE_KEY=

# --- 可选：公开数据源覆盖 ---
OKX_BASE=https://www.okx.com
CG_BASE=https://api.coingecko.com
FNG_BASE=
LLAMA_BASE=
STABLES_BASE=

# --- 可选：6551 消息面（无则自动降级）---
SIXFIVE_TOKEN=

# --- CLI ---
SPRITE_CONFIG=./packages/cli/config.yaml
MON_PRICE_USD=1
MIN_RADAR_SCORE=60
DANGER_SCORE=35
EQUITY=1000
